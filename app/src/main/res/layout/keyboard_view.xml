<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="285dp"
    android:background="#1A1C1E">

    <!-- Normal Typing & Voice Input Layout -->
    <LinearLayout
        android:id="@+id/normal_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Action Strip / Enhanced Suggestion Strip Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#1F2024">

            <!-- Normal Top Bar: Mic, Status, Enhance, Flow, Ask -->
            <LinearLayout
                android:id="@+id/layout_normal_top_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:visibility="visible">

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_mic_button"
                    android:contentDescription="Voice Input"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="4dp"
                    android:text="Tap mic or Enhance"
                    android:textColor="#C4C6D0"
                    android:textSize="11sp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enhance"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="Enhance"
                    android:textSize="10.5sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_sparkle"
                    app:iconSize="13dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="15dp"
                    android:backgroundTint="#2563EB"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_demo"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="Flow"
                    android:textSize="10.5sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_flow"
                    app:iconSize="13dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="15dp"
                    android:backgroundTint="#059669"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ask"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="Ask"
                    android:textSize="10.5sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_lightbulb"
                    app:iconSize="13dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="15dp"
                    android:backgroundTint="#6366F1"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <ProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"
                    android:indeterminate="true" />

            </LinearLayout>

            <!-- Enhanced Text Preview Strip (Gboard style suggestion strip) -->
            <LinearLayout
                android:id="@+id/layout_enhanced_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:background="#242830"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#60A5FA" />

                <TextView
                    android:id="@+id/tv_enhanced_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:ellipsize="marquee"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btn_apply_enhanced"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_mic_button"
                    android:backgroundTint="@color/approve_green"
                    android:contentDescription="Apply enhanced text"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btn_discard_enhanced"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Discard"
                    android:src="@drawable/ic_close"
                    app:tint="#94A3B8" />

            </LinearLayout>

        </FrameLayout>

        <!-- Keyboard Key Rows -->
        <LinearLayout
            android:id="@+id/layout_keyboard_keys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="3dp"
            android:paddingVertical="4dp"
            android:visibility="visible">

            <!-- Row 1: Q W E R T Y U I O P (or 1 2 3 4 5 6 7 8 9 0) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button style="@style/KeyStyle" android:id="@+id/key_q" android:text="q" />
                <Button style="@style/KeyStyle" android:id="@+id/key_w" android:text="w" />
                <Button style="@style/KeyStyle" android:id="@+id/key_e" android:text="e" />
                <Button style="@style/KeyStyle" android:id="@+id/key_r" android:text="r" />
                <Button style="@style/KeyStyle" android:id="@+id/key_t" android:text="t" />
                <Button style="@style/KeyStyle" android:id="@+id/key_y" android:text="y" />
                <Button style="@style/KeyStyle" android:id="@+id/key_u" android:text="u" />
                <Button style="@style/KeyStyle" android:id="@+id/key_i" android:text="i" />
                <Button style="@style/KeyStyle" android:id="@+id/key_o" android:text="o" />
                <Button style="@style/KeyStyle" android:id="@+id/key_p" android:text="p" />
            </LinearLayout>

            <!-- Row 2: A S D F G H J K L (or @ # $ % & - + ( )) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">
                <Button style="@style/KeyStyle" android:id="@+id/key_a" android:text="a" />
                <Button style="@style/KeyStyle" android:id="@+id/key_s" android:text="s" />
                <Button style="@style/KeyStyle" android:id="@+id/key_d" android:text="d" />
                <Button style="@style/KeyStyle" android:id="@+id/key_f" android:text="f" />
                <Button style="@style/KeyStyle" android:id="@+id/key_g" android:text="g" />
                <Button style="@style/KeyStyle" android:id="@+id/key_h" android:text="h" />
                <Button style="@style/KeyStyle" android:id="@+id/key_j" android:text="j" />
                <Button style="@style/KeyStyle" android:id="@+id/key_k" android:text="k" />
                <Button style="@style/KeyStyle" android:id="@+id/key_l" android:text="l" />
            </LinearLayout>

            <!-- Row 3: Shift / Symbol-Alt, Z X C V B N M, Backspace -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    style="@style/ActionKeyStyle"
                    android:id="@+id/key_shift"
                    android:layout_weight="1.3"
                    app:icon="@drawable/ic_shift"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/key_text"
                    android:text="" />
                <Button style="@style/KeyStyle" android:id="@+id/key_z" android:text="z" />
                <Button style="@style/KeyStyle" android:id="@+id/key_x" android:text="x" />
                <Button style="@style/KeyStyle" android:id="@+id/key_c" android:text="c" />
                <Button style="@style/KeyStyle" android:id="@+id/key_v" android:text="v" />
                <Button style="@style/KeyStyle" android:id="@+id/key_b" android:text="b" />
                <Button style="@style/KeyStyle" android:id="@+id/key_n" android:text="n" />
                <Button style="@style/KeyStyle" android:id="@+id/key_m" android:text="m" />
                <com.google.android.material.button.MaterialButton
                    style="@style/ActionKeyStyle"
                    android:id="@+id/key_backspace"
                    android:layout_weight="1.3"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/key_text"
                    android:text="" />
            </LinearLayout>

            <!-- Row 4: ?123, Emoji, Space, Comma, Period, Enter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_123" android:text="@string/key_123_label" android:layout_weight="1.4" />
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_emoji" android:text="😀" android:textSize="17sp" android:layout_weight="1.1" />
                <Button style="@style/KeyStyle" android:id="@+id/key_space" android:text="Space" android:layout_weight="4.3" />
                <Button style="@style/KeyStyle" android:id="@+id/key_comma" android:text="," android:layout_weight="0.8" />
                <Button style="@style/KeyStyle" android:id="@+id/key_period" android:text="." android:layout_weight="0.8" />
                <Button style="@style/EnterKeyStyle" android:id="@+id/key_enter" android:text="↵" android:layout_weight="1.6" />
            </LinearLayout>

        </LinearLayout>

        <!-- Emoji Picker View -->
        <LinearLayout
            android:id="@+id/layout_emoji_picker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E2024"
            android:padding="4dp"
            android:visibility="gone">

            <!-- Category Tabs -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:scrollbars="none"
                android:layout_marginBottom="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_emoji_smileys"
                        style="@style/ActionKeyStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="😀 Smileys"
                        android:textSize="11sp"
                        android:textColor="@color/white"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#4F46E5"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_emoji_gestures"
                        style="@style/ActionKeyStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="👍 Hands"
                        android:textSize="11sp"
                        android:textColor="#C4C6D0"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#2D3035"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_emoji_work"
                        style="@style/ActionKeyStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🚀 Ideas"
                        android:textSize="11sp"
                        android:textColor="#C4C6D0"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#2D3035"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tab_emoji_symbols"
                        style="@style/ActionKeyStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:text="🔥 Reactions"
                        android:textSize="11sp"
                        android:textColor="#C4C6D0"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#2D3035"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Scrollable Emojis Flow/Grid -->
            <ScrollView
                android:id="@+id/scroll_emojis"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <GridLayout
                    android:id="@+id/grid_emojis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false" />
            </ScrollView>

            <!-- Bottom Action Row in Emoji Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_emoji_abc"
                    style="@style/ActionKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:text="ABC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="6dp" />
                <Button
                    android:id="@+id/btn_emoji_space"
                    style="@style/KeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="4"
                    android:text="Space"
                    android:layout_marginHorizontal="4dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_emoji_backspace"
                    style="@style/ActionKeyStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconSize="20dp"
                    app:iconTint="@color/key_text"
                    app:cornerRadius="6dp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Diagram Preview Overlay Layout -->
    <LinearLayout
        android:id="@+id/diagram_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1C1E"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Header / Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagram Preview"
            android:textAlignment="center"
            android:textColor="@color/key_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Rendered Image View (Solid White BG) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iv_diagram_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="Generated Flowchart" />

        </FrameLayout>

        <!-- Action Buttons: Approve (Green) & Discard (Red) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_discard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/discard_red"
                app:icon="@drawable/ic_close"
                app:iconSize="16dp"
                app:iconTint="@color/white"
                app:cornerRadius="8dp"
                android:text="Discard"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_approve"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/approve_green"
                app:icon="@drawable/ic_check"
                app:iconSize="16dp"
                app:iconTint="@color/white"
                app:cornerRadius="8dp"
                android:text="Insert Diagram"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Brainstorm / Subject Matter Expert (SME) Panel Layout -->
    <LinearLayout
        android:id="@+id/brainstorm_panel_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1A1C1E"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_lightbulb"
                app:tint="#818CF8" />

            <TextView
                android:id="@+id/tv_brainstorm_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="SME Brainstorm"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Mode Switch Chips -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_quick"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="Quick"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="12dp"
                android:backgroundTint="#4F46E5"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_live"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="Live Voice"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                app:cornerRadius="12dp"
                android:backgroundTint="#2D3035"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <ImageButton
                android:id="@+id/btn_close_brainstorm"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="#94A3B8" />

        </LinearLayout>

        <!-- CONTAINER 1: Quick Mode Layout -->
        <LinearLayout
            android:id="@+id/layout_brainstorm_quick_mode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Inline Prompt Input Box (Shown when user wants to query or chat bar was empty) -->
            <LinearLayout
                android:id="@+id/layout_brainstorm_query_row"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/et_brainstorm_query"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Ask anything or enter brainstorm topic..."
                    android:textColor="#1F1F1F"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:imeOptions="actionGo" />

                <ImageButton
                    android:id="@+id/btn_brainstorm_send"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Send"
                    android:src="@drawable/ic_send"
                    app:tint="#4F46E5" />

            </LinearLayout>

            <!-- Quick Starter Chips Row -->
            <HorizontalScrollView
                android:id="@+id/scroll_brainstorm_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_quick_msg"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:text="Quick Msg (&lt;50w)"
                        android:textSize="10.5sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#0284C7"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_pros_cons"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:text="Pros &amp; Cons"
                        android:textSize="10.5sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#2563EB"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_strategy"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:text="Key Strategy"
                        android:textSize="10.5sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#4F46E5"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_counterargs"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:text="Counterarguments"
                        android:textSize="10.5sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#1D4ED8"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_explain"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="0dp"
                        android:text="Explain Simply"
                        android:textSize="10.5sp"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:cornerRadius="13dp"
                        android:backgroundTint="#3B82F6"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Result Container with Pastel Concept Cards -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#1E2024"
                android:padding="6dp">

                <ScrollView
                    android:id="@+id/scroll_brainstorm_result"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/layout_brainstorm_cards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_brainstorm_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Enter a topic above or tap a starter chip to brainstorm with your SME."
                            android:textColor="#94A3B8"
                            android:textSize="12.5sp"
                            android:lineSpacingExtra="3dp"
                            android:padding="8dp" />

                    </LinearLayout>

                </ScrollView>

                <ProgressBar
                    android:id="@+id/progress_brainstorm"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true" />

            </FrameLayout>

            <!-- Bottom Action Row: Copy & Insert -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copy_brainstorm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#383A40"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="8dp"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_insert_brainstorm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#059669"
                    app:icon="@drawable/ic_check"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="8dp"
                    android:text="Insert into Chat"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- CONTAINER 2: Live Session Mode Layout -->
        <LinearLayout
            android:id="@+id/layout_brainstorm_live_mode"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Chat Bubble Scroll View -->
            <ScrollView
                android:id="@+id/scroll_session_chat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#242830"
                android:padding="6dp"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/layout_chat_bubbles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <!-- Live Status & Mic Control Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <ImageButton
                    android:id="@+id/btn_session_mic"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_mic_button"
                    android:backgroundTint="#4F46E5"
                    android:contentDescription="Speak turn"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_session_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Tap mic to speak your thought..."
                    android:textColor="#CBD5E1"
                    android:textSize="11.5sp"
                    android:singleLine="true" />

                <ProgressBar
                    android:id="@+id/progress_session"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Live Session Action Row: Reset & Wrap Up -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_session"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#383A40"
                    app:cornerRadius="8dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_conclude_session"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#4F46E5"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_check"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    android:text="Wrap Up &amp; Conclude"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
