<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="280dp"
    android:background="@color/keyboard_bg">

    <!-- Normal Typing & Voice Input Layout -->
    <LinearLayout
        android:id="@+id/normal_keyboard_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Action Strip / Enhanced Suggestion Strip Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/primary_dark">

            <!-- Normal Top Bar: Mic, Status, Enhance, Sample -->
            <LinearLayout
                android:id="@+id/layout_normal_top_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="visible">

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_mic_button"
                    android:contentDescription="Voice Input"
                    android:src="@android:drawable/ic_btn_speak_now"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:text="Tap mic or Enhance"
                    android:textColor="@color/key_text"
                    android:textSize="12sp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:clickable="true"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_enhance"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="✨ Enhance"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="#2563EB"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btn_demo"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="0dp"
                    android:text="📊 Flow"
                    android:textSize="11sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/action_key_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <ProgressBar
                    android:id="@+id/progress_loading"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    android:indeterminate="true" />

            </LinearLayout>

            <!-- Enhanced Text Preview Strip (Shown right below main chat bar!) -->
            <LinearLayout
                android:id="@+id/layout_enhanced_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:background="#1E293B"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ "
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_enhanced_preview"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:ellipsize="marquee"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btn_apply_enhanced"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_mic_button"
                    android:backgroundTint="@color/approve_green"
                    android:contentDescription="Apply enhanced text"
                    android:src="@drawable/ic_check"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/btn_discard_enhanced"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Discard"
                    android:src="@drawable/ic_close"
                    app:tint="#94A3B8" />

            </LinearLayout>

        </FrameLayout>

        <!-- QWERTY Keyboard Keys Rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- Row 1: Q W E R T Y U I O P -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button style="@style/KeyStyle" android:id="@+id/key_q" android:text="Q" />
                <Button style="@style/KeyStyle" android:id="@+id/key_w" android:text="W" />
                <Button style="@style/KeyStyle" android:id="@+id/key_e" android:text="E" />
                <Button style="@style/KeyStyle" android:id="@+id/key_r" android:text="R" />
                <Button style="@style/KeyStyle" android:id="@+id/key_t" android:text="T" />
                <Button style="@style/KeyStyle" android:id="@+id/key_y" android:text="Y" />
                <Button style="@style/KeyStyle" android:id="@+id/key_u" android:text="U" />
                <Button style="@style/KeyStyle" android:id="@+id/key_i" android:text="I" />
                <Button style="@style/KeyStyle" android:id="@+id/key_o" android:text="O" />
                <Button style="@style/KeyStyle" android:id="@+id/key_p" android:text="P" />
            </LinearLayout>

            <!-- Row 2: A S D F G H J K L -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">
                <Button style="@style/KeyStyle" android:id="@+id/key_a" android:text="A" />
                <Button style="@style/KeyStyle" android:id="@+id/key_s" android:text="S" />
                <Button style="@style/KeyStyle" android:id="@+id/key_d" android:text="D" />
                <Button style="@style/KeyStyle" android:id="@+id/key_f" android:text="F" />
                <Button style="@style/KeyStyle" android:id="@+id/key_g" android:text="G" />
                <Button style="@style/KeyStyle" android:id="@+id/key_h" android:text="H" />
                <Button style="@style/KeyStyle" android:id="@+id/key_j" android:text="J" />
                <Button style="@style/KeyStyle" android:id="@+id/key_k" android:text="K" />
                <Button style="@style/KeyStyle" android:id="@+id/key_l" android:text="L" />
            </LinearLayout>

            <!-- Row 3: Shift Z X C V B N M Backspace -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_shift" android:text="⇧" android:layout_weight="1.3" />
                <Button style="@style/KeyStyle" android:id="@+id/key_z" android:text="Z" />
                <Button style="@style/KeyStyle" android:id="@+id/key_x" android:text="X" />
                <Button style="@style/KeyStyle" android:id="@+id/key_c" android:text="C" />
                <Button style="@style/KeyStyle" android:id="@+id/key_v" android:text="V" />
                <Button style="@style/KeyStyle" android:id="@+id/key_b" android:text="B" />
                <Button style="@style/KeyStyle" android:id="@+id/key_n" android:text="N" />
                <Button style="@style/KeyStyle" android:id="@+id/key_m" android:text="M" />
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_backspace" android:text="⌫" android:layout_weight="1.3" />
            </LinearLayout>

            <!-- Row 4: 123 Space Enter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_123" android:text="@string/key_123_label" android:layout_weight="2" />
                <Button style="@style/KeyStyle" android:id="@+id/key_comma" android:text="," android:layout_weight="1" />
                <Button style="@style/KeyStyle" android:id="@+id/key_space" android:text="Space" android:layout_weight="5" />
                <Button style="@style/KeyStyle" android:id="@+id/key_period" android:text="." android:layout_weight="1" />
                <Button style="@style/ActionKeyStyle" android:id="@+id/key_enter" android:text="↵" android:layout_weight="2" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Diagram Preview Overlay Layout -->
    <LinearLayout
        android:id="@+id/diagram_preview_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/keyboard_bg"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Header / Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Diagram Preview (Ready to Insert)"
            android:textAlignment="center"
            android:textColor="@color/key_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <!-- Rendered Image View (Solid White BG) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white"
            android:padding="4dp">

            <ImageView
                android:id="@+id/iv_diagram_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="Generated Flowchart" />

        </FrameLayout>

        <!-- Action Buttons: Approve (Green) & Discard (Red) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_discard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/discard_red"
                android:text="@string/discard"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_approve"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/approve_green"
                android:text="@string/approve"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
