<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="backgroundTint">@color/key_bg</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="ActionKeyStyle" parent="KeyStyle">
        <item name="backgroundTint">@color/action_key_bg</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
